# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL - Switch between Local, Supabase or AWS RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kanban_db?schema=public"

# Authentication & JWT
JWT_SECRET="dev-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="dev-super-secret-refresh-key-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Security (AES-256-GCM Master Key)
ENCRYPTION_SECRET_KEY="32-bytes-secure-random-encryption-key-for-aes256"

# AI Providers (System Fallback Keys)
DEFAULT_AI_PROVIDER="GEMINI"
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"
OPENAI_API_KEY="sk-proj-YourOpenAIApiKey"
ANTHROPIC_API_KEY="sk-ant-YourClaudeApiKey"
